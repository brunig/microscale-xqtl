// Default parameters
params {
    nthreads  = 8
    mem       = '8 GB'
    walltime  = '12h'
    workdir   = null
    conda_env = 'genomicsV2'  // name of existing conda env; override with --conda_env
}

// Allow users to override the Nextflow work directory with --workdir.
// Fall back to the example-local work/ directory when not specified.
workDir = params.workdir ?: "${launchDir}/work"

profiles {

    local {
        process.executor = 'local'

        // Total CPU and memory budget for parallel tasks.
        // Nextflow schedules tasks so that the sum of task.cpus does not
        // exceed this. Adjust to match your machine.
        executor.cpus   = 32
        executor.memory = '64 GB'

        params {
            genome = '/media/hoffman2/PUBLIC_SHARED/yeast/reference/1011/sacCer3.fasta'
            vcf    = '/media/hoffman2/PUBLIC_SHARED/yeast/reference/3000/VCFs_SNPs/1011_allhet_SNPs.vcf.gz'
        }
    }

    hoffman2 {
        process.executor = 'sge'
        process.penv     = 'shared'
        // hoffman2 uses h_data (not h_vmem) and h_rt for walltime
        // -pe shared is needed even for 1 cpu because GATK's JVM spawns internal threads
        // and single-slot SGE jobs have restrictive process limits
        process.clusterOptions = { "-l highp,h_data=${task.memory.toMega()}M" }
        process.errorStrategy  = 'retry'
        process.maxRetries     = 3

        // Max concurrent SGE jobs — adjust to your group's allocation
        // Check with: qquota -u $USER
        executor.queueSize     = 96
        executor.pollInterval  = '30 sec'
        executor.submitRateLimit = '30/1min'

        // Activate conda env for each SGE job (not needed locally if already activated) also SGE worker shells dont auto-laod modules so you have to init
        process.beforeScript = "source /u/local/Modules/default/init/bash && module load mamba && mamba activate ${params.conda_env}"                                 


        params {
            genome = '/u/project/kruglyak/PUBLIC_SHARED/yeast/reference/1011/sacCer3.fasta'
            vcf    = '/u/project/kruglyak/PUBLIC_SHARED/yeast/reference/3000/VCFs_SNPs/1011_allhet_SNPs.vcf.gz'
        }
    }
}

// Pipeline reports
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
